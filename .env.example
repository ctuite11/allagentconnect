# Placeholder env file. Real values live in Lovable/Netlify env vars or the
# Google Maps connector. Never commit real keys.
# Google Maps Platform: provisioned automatically by the linked connector
# (VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_BROWSER_KEY / _TRACKING_ID for the
# browser, GOOGLE_MAPS_API_KEY for edge functions). Do not set manually.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
ATTOM_API_KEY=

# Email pause controls (edge function secrets — not Vite).
# Global fail-closed: unset or anything other than "false" pauses ALL sending.
EMAIL_SENDING_PAUSED=true
# Channel pauses (only when explicitly "true"):
HOT_SHEET_EMAILS_PAUSED=false
COMMS_EMAILS_PAUSED=false