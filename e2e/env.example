# Copy to e2e/.env (gitignored) or export before running:
#   npx playwright test --config=playwright.auth.config.ts
#
# Dedicated E2E accounts only — never real agent/buyer production users.

E2E_BASE_URL=https://splendid-gaufre-49195f.netlify.app

# Pending / unverified agent → expect /pending-verification
E2E_PENDING_AGENT_EMAIL=e2e.pending.agent@allagentconnect.test
E2E_PENDING_AGENT_PASSWORD=

# Verified agent → expect /agent-dashboard
E2E_VERIFIED_AGENT_EMAIL=e2e.verified.agent@allagentconnect.test
E2E_VERIFIED_AGENT_PASSWORD=

