erDiagram
    %% ===== AUTH / ROLES / PROFILES =====
    auth_users ||--|| profiles : "id = id"
    auth_users ||--o| agent_profiles : "id = id"
    auth_users ||--o| agent_settings : "id = user_id"
    auth_users ||--o{ user_roles : "id = user_id"

    profiles {
        uuid id PK
        text email
        text first_name
        text last_name
        timestamptz deactivated_at
    }

    user_roles {
        uuid id PK
        uuid user_id FK
        app_role role
    }

    agent_profiles {
        uuid id PK
        text email
        text first_name
        text last_name
        text aac_id UK
        text office_state
        text headshot_url
    }

    agent_settings {
        uuid user_id PK
        agent_status agent_status
        boolean onboarding_completed
        text license_number
        text license_state
        timestamptz verified_at
    }

    %% ===== MESSAGING =====
    conversations ||--o{ conversation_participants : "id = conversation_id"
    conversations ||--o{ conversation_messages : "id = conversation_id"
    conversations }o--o| listings : "listing_id"
    conversations }o--o| client_needs : "buyer_need_id"

    conversations {
        uuid id PK
        uuid agent_a_id
        uuid agent_b_id
        uuid listing_id FK
        timestamptz last_message_at
    }

    conversation_participants {
        uuid conversation_id PK
        uuid user_id PK
        timestamptz last_read_at
        boolean is_archived
        boolean is_muted
    }

    conversation_messages {
        uuid id PK
        uuid conversation_id FK
        uuid sender_agent_id
        uuid recipient_agent_id
        text body
        timestamptz read_at
    }

    %% ===== BUYER WORKSPACES =====
    user_roles ||--o| buyer_workspaces : "buyer role trigger"
    buyer_workspaces ||--o{ buyer_workspace_members : "id = workspace_id"
    buyer_workspaces ||--o{ buyer_workspace_invites : "id = workspace_id"

    buyer_workspaces {
        uuid id PK
        uuid owner_id UK
    }

    buyer_workspace_members {
        uuid id PK
        uuid workspace_id FK
        uuid user_id
        text role
    }

    buyer_workspace_invites {
        uuid id PK
        uuid workspace_id FK
        text buyer_email
        text token UK
        timestamptz accepted_at
        timestamptz expires_at
    }

    %% ===== CLIENT CRM =====
    agent_profiles ||--o{ clients : "id = agent_id"
    clients ||--o{ client_agent_relationships : "id = client_id"

    clients {
        uuid id PK
        uuid agent_id FK
        text email
        text first_name
        text last_name
        text client_type
        boolean is_favorite
    }

    client_agent_relationships {
        uuid id PK
        uuid client_id FK
        uuid agent_id
        text status
        timestamptz ended_at
    }

    client_needs {
        uuid id PK
        uuid submitted_by FK
        property_type property_type
        numeric max_price
        text city
        text state
    }

    %% ===== LISTINGS =====
    agent_profiles ||--o{ listings : "id = agent_id"
    listings ||--|| listing_stats : "id = listing_id"
    listings ||--o{ listing_views : "id = listing_id"
    listings ||--o{ listing_status_history : "id = listing_id"
    listings ||--o{ listing_price_history : "id = listing_id"
    listings ||--o{ favorites : "id = listing_id"
    listings ||--o{ showing_requests : "id = listing_id"

    listings {
        uuid id PK
        uuid agent_id FK
        text address
        text city
        text state
        text status
        text property_type
        numeric price
        integer bedrooms
        numeric bathrooms
        integer square_feet
        text listing_number UK
    }

    listing_stats {
        uuid id PK
        uuid listing_id UK
        integer view_count
        integer save_count
        integer share_count
    }

    favorites {
        uuid id PK
        uuid user_id
        uuid listing_id FK
    }

    showing_requests {
        uuid id PK
        uuid listing_id FK
        uuid requester_id
        uuid agent_id
        text status
    }

    %% ===== HOT SHEETS =====
    agent_profiles ||--o{ hot_sheets : "id = user_id"
    clients ||--o{ hot_sheet_clients : "id = client_id"
    hot_sheets ||--o{ hot_sheet_clients : "id = hot_sheet_id"
    hot_sheets ||--o{ hot_sheet_comments : "id = hot_sheet_id"
    hot_sheets ||--o{ hot_sheet_sent_listings : "id = hot_sheet_id"
    hot_sheets ||--o{ hot_sheet_listing_status : "id = hot_sheet_id"

    hot_sheets {
        uuid id PK
        uuid user_id FK
        uuid client_id FK
        text name
        jsonb criteria
        boolean is_active
        text notification_schedule
    }

    hot_sheet_clients {
        uuid id PK
        uuid hot_sheet_id FK
        uuid client_id FK
    }

    hot_sheet_comments {
        uuid id PK
        uuid hot_sheet_id FK
        uuid listing_id FK
        uuid sender_id
        text sender_role
        text comment
    }

    hot_sheet_sent_listings {
        uuid id PK
        uuid hot_sheet_id FK
        uuid listing_id FK
        text status_at_send
    }

    %% ===== EMAIL QUEUE =====
    email_jobs {
        uuid id PK
        jsonb payload
        text status
        integer attempts
        text last_error
        text idempotency_key UK
        timestamptz run_after
    }

    %% ===== SELLER MATCHING =====
    agent_match_submissions ||--o{ agent_match_deliveries : "id = submission_id"
    agent_match_submissions ||--o{ seller_matches : "id = submission_id"
    seller_matches ||--o{ seller_match_outcomes : "id = match_id"

    agent_match_submissions {
        uuid id PK
        text address
        text city
        text state
        numeric asking_price
        text status
    }

    seller_matches {
        uuid id PK
        uuid submission_id FK
        uuid agent_id
        seller_match_outcome latest_outcome
    }
